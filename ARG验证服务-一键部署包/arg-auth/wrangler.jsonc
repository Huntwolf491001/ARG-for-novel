{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "arg-auth",
	"main": "src/index.js",
	"compatibility_date": "2026-10-26",
	"limits": {
		"cpu_ms": 1000
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arg-auth",
			"database_id": "00000000-0000-0000-0000-000000000000"
		},
		{
			"binding": "arg_auth_server",
			"database_name": "arg-auth-683dc0f14848",
			"database_id": "9cbffd43-fa3a-45a9-9239-991c5e12f318"
		}
	],
	"ratelimits": [
		{
			"name": "LOGIN_LIMIT",
			"namespace_id": "19001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	]
}